# Modèle du fichier de configuration .env (Horizons Lointains).
#
# 1. Copiez ce fichier sous le nom .env (même dossier, à la racine du dépôt).
# 2. Remplissez les valeurs. Le fichier .env n'est JAMAIS commité (voir .gitignore).
# Une ligne commençant par # est ignorée. Les variables définies dans Windows
# ou sur le serveur restent prioritaires sur ce fichier.

# --- Général --------------------------------------------------------------

# 0 = production (par défaut) ; 1 = développement (erreurs détaillées).
# Sur votre ordinateur, en développement local uniquement : passez cette valeur à 1.
DJANGO_DEBUG=0

# Clé secrète longue et aléatoire, différente sur chaque machine.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# « Poivre » des mots de passe : secret ajouté au hachage, gardé hors de la base.
# Obligatoire en production. À SAUVEGARDER à part : le perdre ou le changer rend tous
# les mots de passe inutilisables. Même commande de génération que la clé secrète.
DJANGO_PASSWORD_PEPPER=

# Noms de domaine autorisés, séparés par des virgules (production uniquement).
# Exemple : horizons-lointains.be,www.horizons-lointains.be
DJANGO_ALLOWED_HOSTS=

# --- E-mails ----------------------------------------------------------------

# Développement : les e-mails s'affichent dans le terminal (aucun envoi réel).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Envoi réel : remplacez la ligne ci-dessus par
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Serveur d'envoi (ici Outlook / Hotmail).
DJANGO_EMAIL_HOST=smtp-mail.outlook.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1

# Adresse et mot de passe de la boîte d'envoi (mot de passe d'application si
# la validation en deux étapes est activée).
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# Expéditeur affiché. Laissé vide : Horizons Lointains <noreply@horizons-lointains.be>,
# l'adresse prévue une fois le serveur d'envoi du domaine en place. En attendant, avec
# Outlook, il doit être identique à DJANGO_EMAIL_HOST_USER (l'adresse Outlook).
DJANGO_DEFAULT_FROM_EMAIL=

# Adresse qui reçoit les réponses des clients (en-tête Reply-To). Vide = pas d'en-tête.
DJANGO_EMAIL_REPLY_TO=info@horizons-lointains.be

# Délai maximal d'attente du serveur d'envoi, en secondes.
DJANGO_EMAIL_TIMEOUT=10

# Adresse commune du personnel qui reçoit l'alerte « Nouvelle demande de voyage ».
# Laissée vide : reservations@horizons-lointains.be
DJANGO_RESERVATIONS_EMAIL=

# Adresse du site, sans « / » final : liens des e-mails envoyés par les commandes planifiées,
# et logo des e-mails. Obligatoire en production. Exemple : https://horizons-lointains.be
# Vide en développement : http://127.0.0.1:8000
DJANGO_SITE_URL=

# Mode test (développement uniquement, toujours désactivé si DJANGO_DEBUG=0) : actif par défaut.
# Avec une adresse ci-dessous, TOUS les e-mails partent à cette adresse (l'adresse d'origine
# est ajoutée dans l'objet) ; sans adresse, ils s'affichent dans le terminal.
DJANGO_EMAIL_TEST_RECIPIENT=
# 0 = désactiver le mode test en développement : les e-mails partent aux vrais destinataires.
DJANGO_EMAIL_TEST_MODE=1

# --- Production (site en HTTPS) ---------------------------------------------

# 1 = rediriger HTTP vers HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1

# HSTS, en secondes : à activer seulement une fois le HTTPS validé (ex. 31536000 = 1 an).
# Difficile à annuler : lire « Activer HSTS » dans le README avant de changer cette valeur.
DJANGO_HSTS_SECONDS=0

# 1 = HSTS aussi pour les sous-domaines (seulement s'ils sont tous en HTTPS).
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0

# Nombre de serveurs intermédiaires (proxy) de confiance devant le site.
# Laisser 0 en accès direct, sinon une adresse IP pourrait être falsifiée.
DJANGO_NUM_PROXIES=0
